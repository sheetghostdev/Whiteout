; Engine configuration file.
; WHITEOUT - a fully procedural incremental weather game.

config_version=5

[application]

config/name="WHITEOUT"
config/description="Cover a living green world in snow and ice."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
Settings="*res://scripts/core/settings_manager.gd"
Audio="*res://scripts/audio/procedural_audio.gd"
Game="*res://scripts/core/game_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.62, 0.78, 0.93, 1)
textures/canvas_textures/default_texture_filter=1

[shader_globals]

wo_height={
"type": "sampler2D",
"value": ""
}
wo_water={
"type": "sampler2D",
"value": ""
}
wo_coverage={
"type": "sampler2D",
"value": ""
}
wo_completion={
"type": "float",
"value": 0.0
}
wo_thaw={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
wo_wind={
"type": "vec2",
"value": Vector2(0, 0)
}
